<view class="product-detail data-v-0e9671aa"><view class="product-image-section data-v-0e9671aa"><image class="product-image data-v-0e9671aa" src="{{product.img||'/static/images/product-default.png'}}" mode="aspectFill" data-event-opts="{{[['error',[['onImageError',['$event']]]]]}}" binderror="__e"></image></view><view class="product-info-section data-v-0e9671aa"><text class="product-name data-v-0e9671aa">{{product.name||'商品名称'}}</text><view class="price-section data-v-0e9671aa"><text class="current-price data-v-0e9671aa">{{"¥"+(product.price||'0.00')}}</text><text class="price-unit data-v-0e9671aa">{{"/"+(product.unit||'斤')}}</text></view><text class="product-description data-v-0e9671aa">{{product.descr||'商品描述'}}</text><view class="product-tags data-v-0e9671aa"><block wx:if="{{product.specials}}"><view class="tag special-tag data-v-0e9671aa">{{''+product.specials+''}}</view></block></view><view class="product-meta data-v-0e9671aa"><view class="meta-item data-v-0e9671aa"><text class="meta-label data-v-0e9671aa">库存</text><text class="{{['meta-value','data-v-0e9671aa',(product.store<=10)?'low-stock':'']}}">{{''+(product.store||0)+(product.unit||'斤')+''}}</text></view></view><block wx:if="{{product.store<=10}}"><view class="stock-warning data-v-0e9671aa"><text class="warning-text data-v-0e9671aa">⚠️ 库存紧张，欲购从速</text></view></block></view><view data-event-opts="{{[['tap',[['showAddressSelect',['$event']]]]]}}" class="address-section data-v-0e9671aa" bindtap="__e"><view class="section-header data-v-0e9671aa"><text class="section-title data-v-0e9671aa">收货地址</text><text class="change-address data-v-0e9671aa">更换</text></view><block wx:if="{{defaultAddress}}"><view class="address-content data-v-0e9671aa"><view class="address-main data-v-0e9671aa"><text class="consignee data-v-0e9671aa">{{defaultAddress.consignee}}</text><text class="phone data-v-0e9671aa">{{defaultAddress.phone}}</text><block wx:if="{{defaultAddress.isDefault}}"><view class="default-tag data-v-0e9671aa">默认</view></block></view><text class="address-detail data-v-0e9671aa">{{''+defaultAddress.province+defaultAddress.city+defaultAddress.district+defaultAddress.detail+''}}</text></view></block><block wx:else><view class="no-address data-v-0e9671aa"><uni-icons vue-id="778f76c8-1" type="location" size="20" color="#999" class="data-v-0e9671aa" bind:__l="__l"></uni-icons><text class="no-address-text data-v-0e9671aa">请选择收货地址</text></view></block></view><view class="quantity-section data-v-0e9671aa"><view class="section-header data-v-0e9671aa"><text class="section-title data-v-0e9671aa">购买数量</text></view><view class="quantity-controls data-v-0e9671aa"><button class="quantity-btn data-v-0e9671aa" disabled="{{quantity<=1}}" data-event-opts="{{[['tap',[['decreaseQuantity',['$event']]]]]}}" bindtap="__e">-</button><input class="quantity-input data-v-0e9671aa" type="number" max="{{product.store}}" data-event-opts="{{[['input',[['__set_model',['','quantity','$event',[]]],['handleQuantityInput',['$event']]]]]}}" value="{{quantity}}" bindinput="__e"/><button class="quantity-btn data-v-0e9671aa" disabled="{{quantity>=product.store}}" data-event-opts="{{[['tap',[['increaseQuantity',['$event']]]]]}}" bindtap="__e">+</button></view></view><view class="action-bar data-v-0e9671aa"><view class="total-price data-v-0e9671aa"><text class="total-label data-v-0e9671aa">总价:</text><text class="total-amount data-v-0e9671aa">{{"¥"+totalPrice}}</text></view><button class="{{['buy-btn','data-v-0e9671aa',(!canBuy)?'disabled':'']}}" disabled="{{!canBuy}}" data-event-opts="{{[['tap',[['handleBuy',['$event']]]]]}}" bindtap="__e">{{''+buyButtonText+''}}</button></view></view>