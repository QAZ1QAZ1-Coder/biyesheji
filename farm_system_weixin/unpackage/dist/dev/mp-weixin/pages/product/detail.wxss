	font-weight: bold;
	color: #ff4757;
}
.buy-btn.data-v-0e9671aa {
	background: #4CD964;
	color: #fff;
	border: none;
	border-radius: 8rpx;
	padding: 20rpx 40rpx;
	font-size: 28rpx;
	font-weight: 500;
	min-width: 160rpx;
	height: 80rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4rpx 12rpx rgba(76, 217, 100, 0.3);
	transition: all 0.3s ease;
}
.buy-btn.data-v-0e9671aa:active {
	-webkit-transform: scale(0.98);
	        transform: scale(0.98);
	box-shadow: 0 2rpx 8rpx rgba(76, 217, 100, 0.4);
}
.buy-btn.disabled.data-v-0e9671aa {
	background: #ccc;
	color: #fff;
	box-shadow: none;
}
.buy-btn.disabled.data-v-0e9671aa:active {
	-webkit-transform: none;
	        transform: none;
	box-shadow: none;
}

