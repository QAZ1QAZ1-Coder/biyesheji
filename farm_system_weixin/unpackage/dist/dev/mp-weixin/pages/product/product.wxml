<view class="product-page"><view class="search-bar"><view class="search-box"><uni-icons vue-id="1c037ce0-1" type="search" size="18" color="#999" bind:__l="__l"></uni-icons><input class="search-input" placeholder="请输入商品名称" data-event-opts="{{[['confirm',[['searchProducts',['$event']]]],['input',[['__set_model',['','searchKeyword','$event',[]]],['handleSearchInput',['$event']]]]]}}" value="{{searchKeyword}}" bindconfirm="__e" bindinput="__e"/><block wx:if="{{searchKeyword}}"><view data-event-opts="{{[['tap',[['clearSearch',['$event']]]]]}}" class="clear-btn" bindtap="__e"><uni-icons vue-id="1c037ce0-2" type="clear" size="16" color="#999" bind:__l="__l"></uni-icons></view></block></view></view><scroll-view class="category-scroll" scroll-x="{{true}}"><view class="category-list"><view data-event-opts="{{[['tap',[['changeCategory',['']]]]]}}" class="{{['category-item',(activeCategory==='')?'active':'']}}" bindtap="__e"> 全部 </view><view data-event-opts="{{[['tap',[['changeCategory',['1']]]]]}}" class="{{['category-item',(activeCategory==='1')?'active':'']}}" bindtap="__e"> 蔬菜 </view><view data-event-opts="{{[['tap',[['changeCategory',['2']]]]]}}" class="{{['category-item',(activeCategory==='2')?'active':'']}}" bindtap="__e"> 水果 </view><view data-event-opts="{{[['tap',[['changeCategory',['3']]]]]}}" class="{{['category-item',(activeCategory==='3')?'active':'']}}" bindtap="__e"> 农副产品 </view><view data-event-opts="{{[['tap',[['changeCategory',['4']]]]]}}" class="{{['category-item',(activeCategory==='4')?'active':'']}}" bindtap="__e"> 菌品 </view><view data-event-opts="{{[['tap',[['changeCategory',['5']]]]]}}" class="{{['category-item',(activeCategory==='5')?'active':'']}}" bindtap="__e"> 水产 </view><view data-event-opts="{{[['tap',[['changeCategory',['6']]]]]}}" class="{{['category-item',(activeCategory==='6')?'active':'']}}" bindtap="__e"> 肉类 </view></view></scroll-view><block wx:if="{{$root.g0}}"><view class="search-tips"><text>{{"搜索\""+searchKeyword+"\"的结果 ("+$root.g1+"个商品)"}}</text></view></block><view class="product-list"><block wx:for="{{productList}}" wx:for-item="product" wx:for-index="__i0__" wx:key="id"><view class="product-card"><view data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['productList','id',product.id,'id']]]]]]]}}" class="product-image" bindtap="__e"><image class="product-img" src="{{product.img||'/static/images/product-default.png'}}" mode="aspectFill" data-event-opts="{{[['error',[['onImageError',['$event']]]]]}}" binderror="__e"></image></view><view class="product-info"><text data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['productList','id',product.id,'id']]]]]]]}}" class="product-name" bindtap="__e">{{product.name||'商品名称'}}</text><text data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['productList','id',product.id,'id']]]]]]]}}" class="product-desc" bindtap="__e">{{product.descr||'新鲜农产品'}}</text><block wx:if="{{product.specials}}"><text class="product-specials">{{product.specials}}</text></block><view class="product-bottom"><view class="price-section"><text class="product-price">{{"¥"+(product.price||'0.00')}}</text><text class="product-unit">{{"/"+(product.unit||'斤')}}</text></view><view class="action-section"><text class="store">{{"库存: "+(product.store||0)}}</text><button data-event-opts="{{[['tap',[['buyNow',['$0'],[[['productList','id',product.id]]]]]]]}}" class="buy-btn" catchtap="__e">立即购买</button></view></view></view></view></block></view><block wx:if="{{hasMore&&!searchKeyword}}"><view class="load-more"><text data-event-opts="{{[['tap',[['loadMore',['$event']]]]]}}" bindtap="__e">加载更多</text></view></block><block wx:if="{{$root.g2}}"><view class="empty-state"><uni-icons vue-id="1c037ce0-3" type="search" size="60" color="#ccc" bind:__l="__l"></uni-icons><text class="empty-text">{{"没有找到\""+searchKeyword+"\"相关的商品"}}</text><button data-event-opts="{{[['tap',[['clearSearch',['$event']]]]]}}" class="retry-btn" bindtap="__e">重新搜索</button></view></block><block wx:if="{{$root.g3}}"><view class="empty-state"><uni-icons vue-id="1c037ce0-4" type="shop" size="60" color="#ccc" bind:__l="__l"></uni-icons><text class="empty-text">暂无商品</text></view></block><block wx:if="{{loading}}"><view class="loading"><text>加载中...</text></view></block></view>