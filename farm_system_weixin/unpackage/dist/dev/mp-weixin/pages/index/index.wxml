<view class="container"><view class="banner-section"><swiper class="banner-swiper" autoplay="{{true}}" interval="{{3000}}" duration="{{500}}" circular="{{true}}"><block wx:for="{{banners}}" wx:for-item="banner" wx:for-index="index" wx:key="index"><swiper-item><image class="banner-image" src="{{banner.image}}" mode="aspectFill" data-event-opts="{{[['error',[['onBannerImageError',['$event']]]]]}}" binderror="__e"></image></swiper-item></block></swiper></view><block wx:if="{{$root.g0>0}}"><view class="notice-section"><uni-notice-bar vue-id="8dd740cc-1" show-icon="{{true}}" single="{{true}}" text="{{currentNoticeContent}}" bind:__l="__l"></uni-notice-bar></view></block><view class="section"><view class="section-title"><text class="title">热门推荐</text><text class="subtitle">源于乡间鲜在舌尖</text></view><block wx:if="{{$root.g1>0}}"><view class="product-list"><block wx:for="{{hotProducts}}" wx:for-item="product" wx:for-index="__i0__" wx:key="id"><view class="product-card"><view data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['hotProducts','id',product.id,'id']]]]]]]}}" class="product-image" bindtap="__e"><image class="product-img" src="{{product.img||'/static/images/product-default.png'}}" mode="aspectFill" data-event-opts="{{[['error',[['onProductImageError',['$event']]]]]}}" binderror="__e"></image></view><view class="product-info"><text data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['hotProducts','id',product.id,'id']]]]]]]}}" class="product-name" bindtap="__e">{{product.name||'商品名称'}}</text><text data-event-opts="{{[['tap',[['viewProductDetail',['$0'],[[['hotProducts','id',product.id,'id']]]]]]]}}" class="product-desc" bindtap="__e">{{product.descr||'新鲜农产品'}}</text><block wx:if="{{product.specials}}"><text class="product-specials">{{product.specials}}</text></block><view class="product-bottom"><view class="price-section"><text class="product-price">{{"¥"+(product.price||'0.00')}}</text><text class="product-unit">{{"/"+(product.unit||'斤')}}</text></view><view class="action-section"><text class="store">{{"库存: "+(product.store||0)}}</text><button data-event-opts="{{[['tap',[['buyNow',['$0'],[[['hotProducts','id',product.id]]]]]]]}}" class="buy-btn" catchtap="__e">立即购买</button></view></view></view></view></block></view></block><block wx:else><view class="empty-state"><text>暂无商品数据</text></view></block></view></view>