nt',[]],['addressForm']]]]]}}" value="{{addressForm.phone}}" bindinput="__e"/></view></view><view class="form-section data-v-db675620"><text class="section-label data-v-db675620">所在地区</text><view class="region-inputs data-v-db675620"><view class="region-item data-v-db675620"><view class="region-input-wrapper data-v-db675620"><input class="form-input region-input data-v-db675620" placeholder="省份" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','province','$event',[]],['addressForm']]]]]}}" value="{{addressForm.province}}" bindinput="__e"/></view></view><view class="region-item data-v-db675620"><view class="region-input-wrapper data-v-db675620"><input class="form-input region-input data-v-db675620" placeholder="城市" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','city','$event',[]],['addressForm']]]]]}}" value="{{addressForm.city}}" bindinput="__e"/></view></view><view class="region-item data-v-db675620"><view class="region-input-wrapper data-v-db675620"><input class="form-input region-input data-v-db675620" placeholder="区县" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','district','$event',[]],['addressForm']]]]]}}" value="{{addressForm.district}}" bindinput="__e"/></view></view></view></view><view class="form-section data-v-db675620"><text class="section-label data-v-db675620">详细地址</text><view class="input-wrapper data-v-db675620"><textarea class="form-textarea data-v-db675620" placeholder="请输入详细地址，如街道、小区、门牌号等" placeholder-class="placeholder" maxlength="100" data-event-opts="{{[['input',[['__set_model',['$0','detail','$event',[]],['addressForm']]]]]}}" value="{{addressForm.detail}}" bindinput="__e"></textarea></view></view><view class="default-setting data-v-db675620"><text class="default-label data-v-db675620">设为默认地址</text><switch checked="{{addressForm.isDefault}}" color="#4CD964" data-event-opts="{{[['change',[['onDefaultChange',['$event']]]]]}}" bindchange="